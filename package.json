{
  "name": "seorap-app",
  "version": "1.0.0",
  "private": true,
  "description": "서랍 — 마감·필기·링크·파일을 한 서랍에 (Electron + 로컬 Llama)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js && node scripts/brand.js",
    "brand": "node scripts/brand.js",
    "web": "node scripts/web.js",
    "dist": "node scripts/release.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.10.0",
    "dompurify": "^3.1.7",
    "firebase": "^12.19.0",
    "katex": "^0.16.11",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.30.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.seorap.app",
    "productName": "서랍",
    "copyright": "서랍",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "shared/**/*",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "서랍",
      "artifactName": "서랍-설치-${version}.exe",
      "installerLanguages": [
        "ko-KR"
      ],
      "language": "1042"
    }
  }
}
